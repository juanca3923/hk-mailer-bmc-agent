# ============================================================
# BMC Helix (obligatorio para herramientas BMC)
# ============================================================
BMC_BASE_URL=https://arus-dev-restapi.onbmc.com
# Login de servicio: además de autenticar, se compara contra el campo Submitter del ticket
# para decidir si bmc_close_work_order/bmc_close_incident pueden cerrarlo (ver require_submitter).
BMC_USERNAME=webservice_mosaico@arus.com.co
BMC_PASSWORD=
# Nombre visible del asignado en Mosaico (campo AR ASCHG en WO / Assignee en Incidente),
# usado al tomar propiedad del ticket antes de cerrarlo. Distinto de BMC_USERNAME (login).
BMC_ASSIGNEE_DISPLAY_NAME=Mosaico WebServices
# Habilita/deshabilita operaciones de escritura (CREATE, UPDATE, CLOSE)
BMC_ALLOW_WRITE=true
# Tiempo de vida del JWT en segundos (default 3600)
# BMC_JWT_TTL_SECONDS=3600
# Margen de renovación anticipada del JWT (default 300)
# BMC_JWT_REFRESH_MARGIN_SECONDS=300
# Timeout HTTP hacia BMC en segundos (default 30)
# BMC_HTTP_TIMEOUT_SECONDS=30
# Tamaño máximo de adjunto en bytes (default 10 MiB)
# BMC_MAX_ATTACHMENT_BYTES=10485760

# ============================================================
# Valores de negocio por defecto (opcional)
# Si no se definen, se usan los valores hardcoded en business_defaults.py
# ============================================================
# BMC_DEFAULT_COMPANY=ARUS
# (Ya no existen BMC_DEFAULT_FIRST_NAME/BMC_DEFAULT_LAST_NAME: el First/Last Name del
# solicitante se resuelve por reporter_email contra CTM:People, no por variable fija.)
# BMC_DEFAULT_CUSTOMER_FIRST_NAME=Mosaico
# BMC_DEFAULT_CUSTOMER_LAST_NAME=WebServices
# BMC_DEFAULT_CUSTOMER_COMPANY=ARUS
# BMC_DEFAULT_ASSIGNED_GROUP=MESA MARCO
# BMC_DEFAULT_INCIDENT_SUPPORT_COMPANY=ARUS
# BMC_DEFAULT_INCIDENT_SUPPORT_ORGANIZATION=MAYA
# BMC_DEFAULT_WORK_ORDER_ASSIGNED_GROUP=MESA MARCO
# BMC_DEFAULT_WORK_ORDER_SUPPORT_COMPANY=ARUS
# BMC_DEFAULT_WORK_ORDER_SUPPORT_ORGANIZATION=MAYA
# (La categorización catch-all de bmc_create_work_order para solicitudes fuera de todo
# dominio conocido vive en skills/guia-creacion-tickets/SKILL.md, sección 1 — no aquí,
# para que la mesa de servicio la actualice editando ese archivo, sin redeploy.)

# ============================================================
# Identificador del agente
# ============================================================
AGENT_SLUG=agent_bmc
# AGENT_DISPLAY_NAME=Agente BMC ARUS
# AGENT_CARD_DESCRIPTION=Agente para gestión de incidentes y órdenes de trabajo en BMC Helix ARUS.

# Zona horaria IANA (nombre de zoneinfo) usada por la tool `get_current_date`.
# Independiente del TZ del sistema operativo del contenedor (ver Dockerfile).
# AGENT_TIMEZONE=America/Bogota

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Proveedor LLM: ollama | openai | anthropic | huggingface (por defecto ollama).
# LLM_PROVIDER=ollama
# Temperatura de muestreo compartida por los 4 proveedores (por defecto 0.6).
# LLM_TEMPERATURE=0.6
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Hugging Face Inference Providers (router https://router.huggingface.co). El modelo debe
# soportar tool calling; no todos los modelos servidos por HF lo hacen de forma confiable.
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Proveedor detrás del router (p.ej. together, novita, cerebras). Vacío = "auto".
# HUGGINGFACE_PROVIDER=
# Organización de HF a la que facturar la inferencia (InferenceClient bill_to=...).
# Vacío = se factura a la cuenta del token.
# HUGGINGFACE_BILL_TO=
# Límite de tokens de salida del endpoint HF (por defecto 2048).
# HUGGINGFACE_MAX_NEW_TOKENS=2048
# SOLO en redes corporativas con inspección TLS cuyo CA raíz usa clave RSA débil (<2048 bits)
# o firma SHA-1 (error típico: "CA certificate key too weak"). Relaja el nivel de seguridad de
# OpenSSL para el cliente de huggingface_hub; la verificación de certificado sigue activa.
# Requiere además la variable estándar SSL_CERT_FILE apuntando a un bundle que incluya ese CA
# corporativo (certifi + tus CAs internos). NUNCA activar en producción.
# HUGGINGFACE_ALLOW_LEGACY_TLS=false
# SSL_CERT_FILE=/ruta/a/bundle-con-ca-corporativo.pem

# Langfuse (self-hosted o cloud): trazas vía callback LangChain si las variables requeridas están definidas.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://172.30.5.201:32030
# Prompt gestionado en Langfuse (nombre). Si lo defines, deben estar las tres claves anteriores y LANGFUSE_PROMPT_LABEL.
# LANGFUSE_PROMPT_NAME=
# Etiqueta del prompt en Langfuse (p. ej. get_prompt); por defecto en la app: latest.
# LANGFUSE_PROMPT_LABEL=latest
# Verificación SSL del servidor Langfuse. Pon false si usas un certificado autofirmado (self-hosted).
# LANGFUSE_SSL_VERIFY=true

# Lista separada por comas (a futuro puedes poner varios):
# MCP_URLS=http://localhost:8001/mcp,http://localhost:9000/mcp
MCP_URLS=http://localhost:8001/mcp

# 1 para activar streaming (si tu modelo/servidor lo soporta)
STREAM=0

LOG_LEVEL=INFO

# Identificador de instancia: patrón ^[a-z][a-z0-9_]*$ (BD sugerida, logs, A2A por defecto).
# AGENT_SLUG=agent_forge

# Nombre visible en Agent Card (vacío → título legible a partir del slug).
# AGENT_DISPLAY_NAME=Mi agente

# Descripción en Agent Card A2A (vacío → texto por defecto que incluye el slug).
# AGENT_CARD_DESCRIPTION=Asistente para diagnóstico Linux; usa MCP y el mismo grafo que POST /chat.

# System prompt: prioridad SYSTEM_PROMPT (texto inline) > LANGFUSE_PROMPT_NAME (si configurado) > archivo SYSTEM_PROMPT_PATH > system.promt.md en la raíz del repo.
# SYSTEM_PROMPT=
# SYSTEM_PROMPT_PATH=/ruta/absoluta/o/relativa/al/repo/prompt.md

# Servicio HTTP (agent-forge-http / uvicorn)
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8000

# CORS: lista separada por comas; "*" = cualquier origen (no combinar con credenciales en navegador).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
# CORS_ALLOW_CREDENTIALS=0

# A2A: servidor (solo con agent-forge-http). Agent Card: GET /.well-known/agent-card.json?assistant_id=...
# Vacío → se usa AGENT_SLUG como assistant_id local.
# A2A_ASSISTANT_ID=
# A2A_PROTOCOL_VERSION=0.2.6

# A2A: agentes remotos (outbound, mismo grafo en CLI y HTTP). Comas; cada entrada OBLIGATORIA:
#   url_base|assistant_id_remoto
# (sin ese formato la entrada se ignora). Ejemplo:
# A2A_PEER_URLS=http://127.0.0.1:9000|otro_agent_slug

# Base de datos Postgres (auditoría y logs de ejecuciones del agente)
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_bmc
# 1 para ver las sentencias SQL en logs (útil en desarrollo)
# DB_ECHO=0

# --- Docker Compose (compose.yml en la raíz)
# Postgres crea la BD en el primer arranque; el nombre por defecto sigue a AGENT_SLUG.
# Pasa el fichero del stack con --env-file (cualquier ruta); las variables se interpolan en compose.yml.
#   docker compose --env-file .env.linux -p mi_agente up -d
# Si no defines DATABASE_URL, Compose arma la URL al servicio postgres con POSTGRES_USER, POSTGRES_PASSWORD y AGENT_SLUG.
# Si defines DATABASE_URL, debe usar el host `postgres` dentro de la red del compose (no localhost). Ejemplo:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/agent_forge
# HTTP_PORT distinto por stack si levantas varios agentes en el mismo host.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
