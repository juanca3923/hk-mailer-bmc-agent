# Desarrollo: incluye documentación (docs/, README) y dependencias de dev (ruff, watchfiles).
# Ver README sección "Docker" para uso.

FROM python:3.14-slim

WORKDIR /app

RUN useradd -m -u 1000 appuser

# Incluir docs y README para desarrollo.
COPY pyproject.toml uv.lock ./
COPY src ./src
COPY system.promt.md system.promt.default.md base.prompt.md ./
# Guías locales (catálogo <skills>); sin skills/example/ (solo plantilla en repo).
COPY skills ./skills
RUN rm -rf ./skills/example
COPY docs ./docs
COPY README.md ./

# uv sync y pip uninstall van en capas distintas: juntas, el image store containerd
# deja la capa vacía y el siguiente RUN no encuentra /bin/sh.
RUN pip install --no-cache-dir uv \
    && uv sync --frozen --group dev --link-mode copy
RUN pip uninstall -y uv \
    && mkdir -p /app/logs /app/data/ticket_files \
    && chown -R appuser:appuser /app/logs /app/data

ENV PATH="/app/.venv/bin:$PATH"
ENV HTTP_HOST=0.0.0.0
ENV HTTP_PORT=8000
# Zona horaria del contenedor (reloj de sistema) y de la tool `get_current_date`
# (AGENT_TIMEZONE en Settings usa el mismo valor por defecto).
ENV TZ=America/Bogota
EXPOSE 8000

USER appuser
CMD ["sh", "-c", "exec watchfiles --ignore-paths logs \"uvicorn http_api.app:app --reload --host ${HTTP_HOST:-0.0.0.0} --port ${HTTP_PORT:-8000}\""]